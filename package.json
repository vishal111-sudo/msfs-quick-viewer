{
  "name": "msfs-quick-viewer",
  "productName": "MSFS Quick Viewer",
  "version": "0.1.3",
  "description": "Browse the aircraft installed in Microsoft Flight Simulator 2024 with thumbnails, categories and search.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "author": "vishal111-sudo",
  "license": "MIT",
  "scripts": {
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "icon": "electron scripts/make-icon.js",
    "smoke": "vite build && electron scripts/smoke.js",
    "scan": "node scripts/probe-scan.js",
    "test": "node --test",
    "dist": "vite build && electron-builder --win portable && node scripts/place-exe.js"
  },
  "build": {
    "appId": "com.msfsquickviewer.app",
    "productName": "MSFS Quick Viewer",
    "copyright": "MSFS Quick Viewer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MSFS-Quick-Viewer-${version}-portable.exe",
      "unicode": true
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "@arclux/arc-ui": "^4.9.1",
    "@arclux/arc-ui-react": "^4.8.2",
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/tomorrow": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "lit": "^3.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vishal111-sudo/msfs-quick-viewer.git"
  },
  "homepage": "https://github.com/vishal111-sudo/msfs-quick-viewer",
  "bugs": {
    "url": "https://github.com/vishal111-sudo/msfs-quick-viewer/issues"
  }
}
